{
  "name": "horizon-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @horizon/web dev",
    "build": "pnpm verify:model && pnpm typecheck && pnpm --filter @horizon/web build && pnpm verify:model --dir react-web-app/dist",
    "build:vercel": "pnpm build && tsx scripts/prepare-vercel.ts",
    "preview": "pnpm --filter @horizon/web preview",
    "audit:dataset": "pnpm --filter @horizon/brain audit:dataset",
    "diagnose:features": "pnpm --filter @horizon/brain diagnose:features",
    "train": "pnpm --filter @horizon/brain train",
    "evaluate": "pnpm --filter @horizon/brain evaluate",
    "sync:model": "pnpm --filter @horizon/brain sync:model",
    "benchmark": "tsx scripts/benchmark.ts",
    "parity:preprocessing": "tsx scripts/preprocessing-parity.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "pnpm format:check && eslint . && tsx scripts/check-architecture.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "review:model": "pnpm --filter @horizon/brain review:model",
    "diagnose:pipeline": "tsx scripts/diagnose-pipeline.ts",
    "diagnose:data": "tsx scripts/diagnose-data.ts",
    "verify:production": "tsx scripts/verify-production-model.ts",
    "prepare:dataset": "pnpm --filter @horizon/brain prepare:dataset",
    "ml": "tsx brain-js/src/cli/entry.ts",
    "benchmark:training": "pnpm ml benchmark",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:python": "ruff format scripts",
    "lint:python": "ruff check scripts && ruff format --check scripts",
    "verify:model": "tsx scripts/check-model.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vercel": "59.25.4",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
